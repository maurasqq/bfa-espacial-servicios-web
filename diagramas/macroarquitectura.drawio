<mxfile host="app.diagrams.net"><diagram name="Macroarquitectura IQTest" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1220"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="u2" value="Macroarquitectura de la plataforma IQTest · todos los módulos en simultáneo" style="text;html=1;fontSize=34;fontStyle=1;fontColor=#222;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1581" height="44" as="geometry"/></mxCell><mxCell id="u3" value="Visión de conjunto para decidir cómo encaja cada módulo (no es el diagrama del entregable del Taller #1)" style="text;html=1;fontSize=20;fontStyle=0;fontColor=#555;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1289" height="30" as="geometry"/></mxCell><mxCell id="u4" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Cliente Web IQTest&lt;/b&gt;&lt;br&gt;un solo portal para todos los módulos" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#dbe8fd;strokeColor=#4f7cc4;fontSize=22;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="520" height="90" as="geometry"/></mxCell><mxCell id="u5" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#1f5fbf;fontColor=#1f5fbf;fontSize=18;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="210" as="sourcePoint"/><mxPoint x="1200" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u6" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;único punto de entrada&lt;br&gt;TLS · enruta por prefijo /api/{módulo}/v1&lt;br&gt;valida el token antes de reenviar" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#f1f1f1;strokeColor=#7a7a7a;fontSize=20;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="258" width="520" height="140" as="geometry"/></mxCell><mxCell id="u7" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Autenticación IQTest (centralizada)&lt;/b&gt;&lt;br&gt;emite un token firmado (JWT) con CIF y rol&lt;br&gt;todos los módulos SOLO lo validan;&lt;br&gt;ninguno hace login propio" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#fbdcdb;strokeColor=#c0504d;fontSize=18;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="258" width="580" height="140" as="geometry"/></mxCell><mxCell id="u8" value="token confiable" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#b03030;fontColor=#b03030;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="328" as="sourcePoint"/><mxPoint x="940" y="328" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u9" value="&lt;b&gt;Mejora a futuro (no bloqueante)&lt;/b&gt;&lt;br&gt;Si el Dashboard necesita el resultado&lt;br&gt;de TODOS los módulos apenas termine&lt;br&gt;el aspirante, conviene un bus de eventos:&lt;br&gt;cada módulo publica &quot;resultado calculado&quot;&lt;br&gt;y el Dashboard escucha, en vez de&lt;br&gt;preguntar por HTTP a cada uno." style="shape=note;size=18;html=1;whiteSpace=wrap;fillColor=#fffde7;strokeColor=#8a8a3a;fontSize=17;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1780" y="258" width="560" height="215" as="geometry"/></mxCell><mxCell id="u10" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#333;dashed=1;dashPattern=1 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1780" y="330" as="sourcePoint"/><mxPoint x="1460" y="328" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u11" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#333;fontColor=#333;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="398" as="sourcePoint"/><mxPoint x="270" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u12" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;BFA Espacial  ◄ nuestro&lt;/b&gt;&lt;br&gt;tu módulo&lt;br&gt;&lt;br&gt;stateless: nada de estado de&lt;br&gt;examen en memoria (el reloj&lt;br&gt;vive en la base de datos)" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#dcf0dc;strokeColor=#3f8f4a;fontSize=17;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="458" width="420" height="210" as="geometry"/></mxCell><mxCell id="u13" value="&lt;i&gt;«database»&lt;/i&gt;&lt;br&gt;&lt;b&gt;BD propia&lt;/b&gt;" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#ffe8cc;strokeColor=#d98a1c;fontSize=15;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="175" y="720" width="190" height="74" as="geometry"/></mxCell><mxCell id="u14" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#b26a00;fontColor=#b26a00;fontSize=15;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="668" as="sourcePoint"/><mxPoint x="270" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u15" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#333;fontColor=#333;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="398" as="sourcePoint"/><mxPoint x="730" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u16" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Vocabulario&lt;/b&gt;&lt;br&gt;otro equipo&lt;br&gt;&lt;br&gt;stateless: nada de estado de&lt;br&gt;examen en memoria (el reloj&lt;br&gt;vive en la base de datos)" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontSize=17;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="458" width="420" height="210" as="geometry"/></mxCell><mxCell id="u17" value="&lt;i&gt;«database»&lt;/i&gt;&lt;br&gt;&lt;b&gt;BD propia&lt;/b&gt;" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#ffe8cc;strokeColor=#d98a1c;fontSize=15;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="635" y="720" width="190" height="74" as="geometry"/></mxCell><mxCell id="u18" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#b26a00;fontColor=#b26a00;fontSize=15;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="668" as="sourcePoint"/><mxPoint x="730" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u19" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;strokeColor=#333;fontColor=#333;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="398" as="sourcePoint"/><mxPoint x="1190" y="458" as="targetPoint"/></mxGeometry></mxCell><mxCell id="u20" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Razonamiento&lt;/b&gt;&lt;br&gt;otro equipo&lt;br&gt;&lt;br&gt;stateless: nada de estado de&lt;br&gt;examen en memoria (el reloj&lt;br&gt;vive en la base de datos)" style="shape=module;jettyWidth=10;jettyHeight=5;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontSize=17;align=center;verticalAlign=top;spacingLeft=0;spacingTop=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="458" width="420" height="210" as="geometry"/></mxCell><mxCel